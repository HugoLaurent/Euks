# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Uploads
UPLOAD_MULTIPART_LIMIT=500mb

# Database
DB_CONNECTION=pg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=euks
DB_PASSWORD=
DB_DATABASE=euks_db

# System users
ADMIN_EMAIL=admin@euks.local
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Admin
OWNER_EMAIL=owner@euks.local
OWNER_PASSWORD=
OWNER_FULL_NAME=Site Owner

# PayPal
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_CURRENCY_CODE is canonical; PAYPAL_CURRENCY is accepted as an alias.
PAYPAL_CURRENCY_CODE=EUR
PAYPAL_BUYER_COUNTRY=FR
PAYPAL_DEFAULT_LOCALE=fr-FR

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
